# Resend API key for the yoova waitlist (https://resend.com)
RESEND_API_KEY=

# Optional: from-address for waitlist emails. Domain must be verified in Resend.
# Defaults to "yoova <yoova@barlow-labs.com>"
HOUSE360_FROM_EMAIL=

# Optional: where new-signup notifications are sent. Defaults to parth@barlow-labs.com
HOUSE360_NOTIFY_EMAIL=

# Sign in with Slack (members area). From your Slack app's Basic Information page.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Secret used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Optional: your Slack workspace team ID (starts with T). If set, sign-ins from
# any other workspace are rejected as a second line of defense.
SLACK_TEAM_ID=

# ── Slack archive (members-only wiki at /members/archive) ────────────────────
# Bot token for the Theo app. Needs: channels:read, channels:join,
# channels:history, users:read, files:read.
SLACK_BOT_TOKEN=

# Neon connection string (already required by the documents/bootstrapper areas).
DATABASE_URL=

# Shared secret Vercel Cron sends as `Authorization: Bearer <secret>`.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Used by /api/archive/summarize to write the monthly wiki summaries.
ANTHROPIC_API_KEY=

# Optional: per-invocation time budget for the sync, in ms (default 50000).
ARCHIVE_SYNC_BUDGET_MS=

# ── F3 Cascades workspace (archive at /f3/archive) ───────────────────────────
# Bot token for the F3 Slack app. Needs: channels:read, channels:join,
# channels:history, users:read (files:read to mirror attachments).
F3_SLACK_BOT_TOKEN=

# Sign in with Slack credentials for the F3 app, so PAX can read their own
# archive. The app must be installed in the F3 workspace and have
# /api/auth/slack/callback registered as a redirect URL.
F3_SLACK_CLIENT_ID=
F3_SLACK_CLIENT_SECRET=

# Optional override; defaults to the F3 Cascades team ID.
F3_SLACK_TEAM_ID=
